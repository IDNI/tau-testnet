# Tau-Driven Consensus — stake-switch demo genesis (validator membership IN TAU)
#
# The validator SET is encoded in this rule, not hardcoded in the node. v1
# interface (i6..i11 / o6 / o7) plus:
#   i13: proposer BLS pubkey (bv[384])
#   i15: eligibility mode flag, 0 = tau_validator_set (this rule), 1 = stake
#
# o7 (proposer eligibility) is constrained ONLY when i15 = 0 (mode guard), and is
# FORCED both ways so the engine always emits a verdict:
#   proposer pubkey in {V1,V2,V3}  -> o7 = 1  (eligible)
#   proposer pubkey NOT in the set -> o7 = 0  (refused by Tau, not by host code)
# In stake mode (i15 != 0) o7 is left free here, so a stake revision that defines
# o7 for i15 = 1 composes with this rule without contradiction.
#
# This fixture is the rendered form, carrying the a/b/c *96 validators the native
# e2e test uses. The demo repo (demo/stake-switch) keeps the .tmpl and the
# renderer that substitute real node pubkeys after key generation.
always (
    o6[t]:bv[16] = i10[t]:bv[16] &&
    ( i15[t]:bv[16] != { 0 }:bv[16] ||
      ( ( ( i13[t]:bv[384] = { #xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa }:bv[384] ||
            i13[t]:bv[384] = { #xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb }:bv[384] ||
            i13[t]:bv[384] = { #xcccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc }:bv[384] ) &&
          o7[t]:bv[16] = { 1 }:bv[16] ) ||
        ( i13[t]:bv[384] != { #xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa }:bv[384] &&
          i13[t]:bv[384] != { #xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb }:bv[384] &&
          i13[t]:bv[384] != { #xcccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc }:bv[384] &&
          o7[t]:bv[16] = { 0 }:bv[16] ) ) )
)
